# Copy to .env for local collect (never commit .env).
# Rotate any key that was pasted into chat or committed by mistake.

GROQ_API_KEY=
# Optional: comma-separated primary→fallback chain
# PARKHU_GROQ_MODELS=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct,llama-3.1-8b-instant
# Or set primary only (defaults append remaining fallbacks):
# PARKHU_GROQ_MODEL=llama-3.3-70b-versatile

# Swing hold mandate (trading days). Max 22 ≈ 1 month; T1 beyond this is rejected.
# PARKHU_HORIZON_MIN_DAYS=3
# PARKHU_HORIZON_MAX_DAYS=22

# Groq pacing (seconds between HTTP calls; default 2.1 ≈ ≤30 RPM)
# PARKHU_GROQ_MIN_INTERVAL_S=2.1

# Daily OHLC history (Yahoo). Raw store: database/ohlc/<SYMBOL>.csv (GitHub).
# LOOKBACK=0 means keep ALL Yahoo sessions (never trim). Cold/new: period=max.
# PARKHU_OHLC_LOOKBACK=0
# PARKHU_OHLC_INCREMENTAL_DAYS=5
# PARKHU_OHLC_WARM_MIN_BARS=240
# PARKHU_OHLC_COLD_PERIOD=max
# Research shares keep-all semantics:
# PARKHU_OHLC_RESEARCH_LOOKBACK=0
# PARKHU_OHLC_RESEARCH_PERIOD=max
# Pipeline: post_close (default) or premarket_context
# PARKHU_RUN_MODE=post_close
# PARKHU_OHLC_CHUNK_SIZE=40
# PARKHU_OHLC_CHUNK_SLEEP_S=1.5
# On Yahoo rate-limit: probe early, resume as soon as ready (escalate toward WAIT).
# PARKHU_OHLC_RETRY_PROBE_S=15
# PARKHU_OHLC_RETRY_WAIT_S=210
# Full 5y universe: raise retries, e.g. PARKHU_OHLC_RETRY_MAX=50
# PARKHU_OHLC_RETRY_MAX=2
# PARKHU_OHLC_YF_THREADS=1
# Permanent Yahoo misses / short history (one-by-one pending filler):
# PARKHU_OHLC_IGNORE_PATH=database/ohlc_ignore.csv

# Relative-volume funnel gate (CONFIG DECISION; start 1.0).
# PARKHU_MIN_RELATIVE_VOLUME=1.0

# Research demotions from leave-one-gate-out (Epic B). Live brief ignores these
# unless you later wire them into swing_brief deliberately.
# PARKHU_RESEARCH_DEMOTED_GATES=trend,sma200
# PARKHU_RESEARCH_APPLY_DEMOTIONS=0

# Research regime filter (Epic C Step 4). Live brief ignores these.
# PARKHU_RESEARCH_DISABLE_REGIMES=range_high_vol
# PARKHU_RESEARCH_APPLY_REGIME_FILTER=0

# Live Buy-band score coverage floor (Epic C Step 5). 0 = off.
# PARKHU_MIN_SCORE_COMPONENTS=0

# Pre-committed kill / pause bar (Epic C Step 7) — docs/kill-criterion.md
# PARKHU_KILL_MIN_CLOSED=20
# PARKHU_KILL_MIN_WIN_RATE_PCT=40
# PARKHU_KILL_MIN_AVG_RETURN_PCT=0

# Epic D Step 8 research flags (not wired into live swing_brief yet).
# PARKHU_RESEARCH_APPLY_GARCH_STOPS=0
# PARKHU_RESEARCH_APPLY_RISK_SIZING=0


# Stock equity option chains (NSE). Off by default — slow / Akamai-sensitive.
# PARKHU_STOCK_OPTIONS=0
# PARKHU_STOCK_OPTIONS_MAX=50
# PARKHU_STOCK_OPTIONS_DELAY_S=1.0
