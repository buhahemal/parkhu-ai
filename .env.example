# Copy to .env for local collect (never commit .env).
# Rotate any key that was pasted into chat or committed by mistake.

GROQ_API_KEY=
# Optional: comma-separated primary→fallback chain
# PARKHU_GROQ_MODELS=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct,llama-3.1-8b-instant
# Or set primary only (defaults append remaining fallbacks):
# PARKHU_GROQ_MODEL=llama-3.3-70b-versatile

# Swing hold mandate (trading days). Max 22 ≈ 1 month; T1 beyond this is rejected.
# PARKHU_HORIZON_MIN_DAYS=3
# PARKHU_HORIZON_MAX_DAYS=22

# Groq pacing (seconds between HTTP calls; default 2.1 ≈ ≤30 RPM)
# PARKHU_GROQ_MIN_INTERVAL_S=2.1
