logs/*.log

# OS
.DS_Store

# Local tool config (machine-specific, not shared)
.claude/settings.local.json

# Applied / obsolete patch packs (live code is on main)
parkhu-phase-0-2/

# Keep output structure but ignore nothing by default so daily data is committed.
# If you do NOT want to commit collected data, uncomment the next line:
# output/
